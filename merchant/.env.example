# Neon Postgres database connection strings
# Get these from your Neon console: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require"

# Razorpay Test Mode API credentials
# Get these from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID="rzp_test_yourKeyId"
RAZORPAY_KEY_SECRET="yourKeySecret"

# Razorpay Webhook Secret (configured in Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET="yourWebhookSecret"

# The server-enforced budget wall in paise (900000 paise = ₹9,000.00).
# Never modifiable by the client or agent.
MAX_BUDGET_PAISE=900000

# Service port (default 3000)
PORT=3000

# Allowed frontend origin for strict CORS (e.g. https://gofer.vercel.app)
# Localhost:5173 is always allowed automatically in development.
FRONTEND_URL=http://localhost:5173

# Optional: Public base URL if behind a reverse proxy that does not send x-forwarded headers
# PUBLIC_BASE_URL=https://gofer-merchant.onrender.com
