# Google Gemini API key
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Model to use for function calling
GEMINI_MODEL=gemini-3.6-flash

# Base URL of the running merchant service
MERCHANT_BASE_URL=http://localhost:3000

# Informational only — passed to Gemini as prompt context.
# The REAL hard budget ceiling is enforced strictly by merchant/server.js (MAX_BUDGET_PAISE).
BUDGET_PAISE_FOR_PROMPT=900000

# Service port (default 3001)
PORT=3001

# Allowed frontend origin for strict CORS (e.g. https://gofer.vercel.app)
# Localhost:5173 is always allowed automatically in development.
FRONTEND_URL=http://localhost:5173

# Headless mode for Puppeteer checkout automation (true in production/cloud, false for visual local debugging)
HEADLESS=true
