# Optional: Bridge URL for standalone test runs of headlessCheckout.js
# When spawned by the agent service, BRIDGE_URL is automatically injected per order.
BRIDGE_URL=http://localhost:3000/checkout/test

# Run Puppeteer headless (true for container/production, false for visual browser window during local debugging)
HEADLESS=true

# Optional: Path to custom Chromium binary (e.g. /usr/bin/chromium in Docker/Debian)
# Leave unset to use Puppeteer's bundled Chromium.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
